# --- App ---
HTTP_ADDR=:8080
SWAGGER_HOST=localhost:8080
UPLOAD_DIR=./data/uploads
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080

# --- Compose published ports (host:container) ---
API_PORT=8080
FRONTEND_PORT=3000

# --- Frontend (Next.js) ---
# Browser calls the API via the host-mapped port (not the Docker service name).
# Baked into the frontend image at build time (NEXT_PUBLIC_*).
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- PostgreSQL ---
POSTGRES_USER=filetemp
POSTGRES_PASSWORD=filetemp
POSTGRES_DB=filetemp
POSTGRES_PORT=5432
# Host / task usage (localhost). Inside Compose the API overrides this to @postgres.
DATABASE_URL=postgres://filetemp:filetemp@localhost:5432/filetemp?sslmode=disable

# --- JWT (single token — no refresh) ---
JWT_SECRET=change-me-jwt-secret
JWT_TTL=24h

# --- MinIO / S3 (planned — local disk storage for now) ---
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=transfers
# MINIO_USE_SSL=false

# --- RabbitMQ (worker via task worker:run; management UI :15672) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Gmail (planned — owner implements mailer; send via personal Google account) ---
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_FROM=you@gmail.com
