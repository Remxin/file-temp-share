{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "go@1.23",
    "gopls@latest",
    "golangci-lint@latest",
    "sqlc@latest",
    "go-task@latest",
    "nodejs_22@latest"
  ],
  "shell": {
    "init_hook": [
      "export PATH=\"$PWD/bin:$PATH\"",
      "echo 'file-temp-share toolbox ready (devbox)'",
      "command -v migrate >/dev/null || echo 'hint: run task tools:install  # installs golang-migrate (postgres)'"
    ],
    "scripts": {
      "check": [
        "go version",
        "sqlc version",
        "migrate -version",
        "task --version",
        "node --version"
      ]
    }
  }
}
